HOST=127.0.0.1
PORT=5173
BASE_URL=http://127.0.0.1:5173
HTTPS_PROXY=
HTTP_PROXY=
DATABASE_URL=
# Local JSON fallback is development-only. Keep false in production.
DATABASE_FALLBACK_ON_ERROR=false

# Comma-separated list of admin emails. Leave empty only for local development.
ADMIN_EMAILS=

GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret

# Billing provider:
# - paypal: use PayPal subscriptions + webhook verification
# - lemonsqueezy: use Lemon Squeezy hosted checkout/portal URLs
# - paddle: legacy hosted checkout/portal compatibility
# - stripe: use Stripe Checkout and webhooks
BILLING_PROVIDER=paypal
BILLING_PRICE_ID=
BILLING_PLAN_CODE=subscription
BILLING_CHECKOUT_URL=
BILLING_PORTAL_URL=
BILLING_WEBHOOK_SECRET=

# PayPal subscriptions.
PAYPAL_MODE=sandbox
PAYPAL_API_BASE_URL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_PORTAL_URL=https://www.paypal.com/myaccount/autopay/
PAYPAL_PLAN_CODE=subscription

# Lemon Squeezy aliases for the hosted flow. The app accepts either the
# BILLING_* names above or these Lemon-specific names.
LEMONSQUEEZY_PRICE_ID=price_xxx
LEMONSQUEEZY_PLAN_CODE=subscription
LEMONSQUEEZY_CHECKOUT_URL=
LEMONSQUEEZY_PORTAL_URL=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Legacy Paddle aliases for the hosted flow.
PADDLE_PRICE_ID=price_xxx
PADDLE_PLAN_CODE=subscription
PADDLE_CHECKOUT_URL=
PADDLE_PORTAL_URL=
PADDLE_WEBHOOK_SECRET=

# Legacy / optional Stripe compatibility.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx

SEEDREAM_API_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_API_KEY=seedream_key
SEEDREAM_MODEL_ID=doubao-seedream-4-0-250828
